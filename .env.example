# Copy to .env.local for local dev. All optional: with none set, the app runs
# in test mode (fake payments, JSON file ledger in ./data).

# Stripe. Set both to take real payments; presses are then recorded by the
# webhook at /api/stripe/webhook (event: checkout.session.completed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL used for Stripe success/cancel redirects (Netlify sets URL too).
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Moderation: DELETE /api/admin/press?id=N with "Authorization: Bearer <token>"
ADMIN_TOKEN=

# Extra blocked words for names, comma-separated (see lib/moderation.ts)
BLOCKED_WORDS=

# Shown in the footer as the contact address.
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Storage override: "blobs" (Netlify Blobs) or "file". Auto-detects on Netlify.
# STORE=
